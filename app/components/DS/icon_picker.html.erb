<div data-controller="icon-picker" class="flex flex-col gap-2" data-action="toggle@document->icon-picker#resetOnClose:capture keydown->icon-picker#handleKeydown">
  <%# Enter in the search field would otherwise submit the surrounding
      category/goal form. %>
  <%= render DS::SearchInput.new(
        variant: :standalone,
        placeholder: placeholder,
        data: {
          icon_picker_target: "input",
          action: "input->icon-picker#filter"
        }
      ) %>

  <div data-icon-picker-target="list" class="flex flex-wrap gap-0.5 max-h-52 overflow-y-auto scrollbar">
    <p class="hidden px-1 py-2 text-sm text-secondary" data-icon-picker-target="emptyMessage" role="status">
      <%= t("ds.icon_picker.no_matching_icons") %>
    </p>

    <%# The `label > input + div > svg` nesting is load-bearing: `color-icon-picker`
        tints `input.nextElementSibling` and clones the svg out of the closest label. %>
    <% icons.each do |icon_name| %>
      <label class="filterable-item relative" data-filter-name="<%= icon_name %>" data-icon-picker-target="item"
             data-icon-picker-names="<%= search_names(icon_name).to_json %>"
             data-icon-picker-keywords="<%= search_keywords(icon_name).to_json %>" title="<%= icon_label(icon_name) %>">
        <%= form.radio_button method, icon_name, class: "sr-only peer", aria: { label: icon_label(icon_name) }, data: {
              action: "change->color-icon-picker#handleIconChange change->color-icon-picker#handleIconColorChange",
              color_icon_picker_target: "icon"
            } %>
        <div class="text-secondary w-7 h-7 flex m-0.5 items-center justify-center rounded-full cursor-pointer hover:bg-container-inset-hover peer-checked:bg-container-inset border border-transparent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus-ring">
          <%= helpers.icon(icon_name, size: "sm", color: "current") %>
        </div>
      </label>
    <% end %>
  </div>
</div>
