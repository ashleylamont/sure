<%# locals: (data:) %>
<%= render DS::Card.new(class: "gap-4 privacy-sensitive") do %>
  <h2 class="text-lg font-medium text-primary"><%= data[:account_name] %></h2>
  <%= render DS::Alert.new(variant: "warning", message: funding_reason(data[:review_reason])) if data[:review_reason] %>
  <dl class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <% %i[cash fixed_reserved operating_floor unallocated shortage].each do |field| %>
      <div>
        <dt class="text-sm text-secondary"><%= t("goal_funding.#{field}") %></dt>
        <dd class="text-lg font-medium text-primary"><%= funding_money(data[field], data[:currency]) %></dd>
      </div>
    <% end %>
  </dl>
  <p class="text-xs text-secondary"><%= t("goal_funding.reconciled", date: data[:reconciled_at] ? l(Time.iso8601(data[:reconciled_at]), format: :short) : t("goal_funding.unknown_cash")) %></p>
  <%= render DS::Table.new(rows: data[:reservations], label: t("goal_funding.reservations")) do |table| %>
    <% table.with_column(t("goal_funding.purpose")) { |item| item[:goal_name] } %>
    <% table.with_column(t("goal_funding.reserved_now"), numeric: true) { |item| item[:whole_account] ? t("goal_funding.whole_account") : funding_money(item[:reserved], data[:currency]) } %>
  <% end %>
<% end %>
